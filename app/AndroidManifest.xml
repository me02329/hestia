<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.hestia.tv"
    android:versionCode="12"
    android:versionName="1.11-safe">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Uninstall from the app menu: Android still shows its own confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Android 11+: without this list the app can't "see" the other apps (getLeanbackLaunchIntentForPackage
         returns null). The shelf and streaming apps, the live TV apps and, through the <intent>, every TV app
         (for "All Apps"). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <package android:name="com.netflix.ninja" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.hulu.livingroomplus" />
        <package android:name="com.cbs.ott" />
        <package android:name="com.peacocktv.peacockandroid" />
        <package android:name="com.globo.globotv" />
        <package android:name="com.spotify.tv.android" />
        <package android:name="com.android.vending" />
        <package android:name="com.tcl.tv" />
        <package android:name="com.google.android.tv" />
        <package android:name="com.mediatek.wwtv.tvcenter" />
        <package android:name="com.sony.dtv.tvx" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:host="android.media.tv" />
        </intent>
        <!-- The TV's web browser, for the news articles (NewsActivity). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Hestia"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">

        <!-- The app's icon opens the settings (favorites, headlines, screensaver, home choice). -->
        <activity
            android:name=".SettingsActivity"
            android:process=":home"
            android:exported="true"
            android:label="Hestia"
            android:launchMode="singleTask"
            android:taskAffinity="io.hestia.tv.settings"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Hestia.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Repeated Java crashes lead to a simple recovery screen. -->
        <activity
            android:name=".HomeActivity"
            android:process=":home"
            android:exported="true"
            android:label="Hestia"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Hestia.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The list of cybersecurity headlines (OK on the home screen's headline). -->
        <activity
            android:name=".NewsActivity"
            android:process=":home"
            android:exported="false"
            android:label="Hestia"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Hestia.Home" />

        <!-- Quick panel: the remote's Settings button on the home screen, and a long press on Home anywhere
             (System UI looks for TOGGLE_NOTIFICATION_HANDLER_PANEL, which Google TV's launcher used to handle). -->
        <activity
            android:name=".QuickPanelActivity"
            android:process=":home"
            android:exported="true"
            android:label="Hestia"
            android:launchMode="singleTask"
            android:taskAffinity="io.hestia.tv.panel"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Hestia.Panel">
            <intent-filter>
                <action android:name="android.app.action.TOGGLE_NOTIFICATION_HANDLER_PANEL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings › Remote buttons: what the TV / Settings buttons and Home held down open. -->
        <activity
            android:name=".RemoteKeysActivity"
            android:process=":home"
            android:exported="false"
            android:label="Hestia"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Hestia.Panel" />

        <!-- Long press OK on an app card. -->
        <activity
            android:name=".AppMenuActivity"
            android:process=":home"
            android:exported="false"
            android:label="Hestia"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@style/Hestia.Panel" />

        <service
            android:name=".Screensaver"
            android:process=":home"
            android:exported="true"
            android:label="Hestia"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Notification access, only so the quick panel can show and control what's playing (see MediaListener). -->
        <service
            android:name=".MediaListener"
            android:process=":home"
            android:exported="true"
            android:label="Hestia"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The remote's Settings button inside other apps (they receive it and ignore it): key events only. -->
        <service
            android:name=".RemoteKeysService"
            android:process=":home"
            android:exported="true"
            android:label="Hestia"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/remote_keys_service" />
        </service>

    </application>
</manifest>
